<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:powershell="http://schemas.gardiner.net.au/PowerShellWixExtensionSchema">
  <Package Name="PowerShellWixTest" Language="1033" Version="1.0.0.0" Manufacturer="David Gardiner" UpgradeCode="C61298AF-D8C9-4179-903F-F42FA69B59AD">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="PowerShellWixTest" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

<!--
    <InstallExecuteSequence>
      <Custom Action="PowerShellScriptsDeferred" After="RegisterUser">NOT Installed</Custom>

      <Custom Action="PowerShellScriptsElevatedDeferred" After="InstallFiles">NOT Installed</Custom>

      <Custom Action="PowerShellFilesDeferred" After="InstallFiles">NOT Installed</Custom>

      <Custom Action="PowerShellFilesElevatedDeferred" After="InstallFiles">NOT Installed</Custom>
    </InstallExecuteSequence>
-->

    
    <powershell:File Id="PSFile1" File="[#TestPs1]" Arguments="&quot;First Argument&quot; 1" />
    <powershell:File Id="PSFile2" File="[#TestPs1]" Arguments="&quot;Second Argument&quot; 2" Elevated="yes" />

    <powershell:Script Id="Script2" Elevated="no" Script="" />

    
    <powershell:Script Id="Script3" Elevated="yes" Script="" />


    <powershell:Script Id="Script4" Script="IwAgAHQAaAByAG8AdwAgACIAbwBoACAAZABlAGEAcgAiADsACgAgACAAIAAgACAAIAAgACAAZQB4AGkAdAAgADEA" IgnoreErrors="yes" />


    <powershell:Script Id="Script5" Script="VwByAGkAdABlAC0ASABvAHMAdAAgACIAVABoAGkAcwAgAHMAYwByAGkAcAB0ACAAcwBoAG8AdQBsAGQAIABuAG8AdAAgAHIAdQBuACAAYgBlAGMAYQB1AHMAZQAgAHQAaABlACAAcAByAGUAdgBpAG8AdQBzACAAbwBuAGUAIAByAGEAaQBzAGUAZAAgAGEAbgAgAGUAeABjAGUAcAB0AGkAbwBuACIA" />


    
    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="PowerShellWixTest" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ProductComponent">
        <File Id="TestPs1" Source="Test.ps1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="PowerShellWixExtensionSchema"
    targetNamespace="http://schemas.gardiner.net.au/PowerShellWixExtensionSchema"
    elementFormDefault="qualified"
    xmlns="http://schemas.gardiner.net.au/PowerShellWixExtensionSchema"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xse="http://schemas.microsoft.com/wix/2005/XmlSchemaExtension"
    xmlns:wix="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:pse="http://wixtoolset.org/schemas/v4/wix/schema"
>
  <xs:annotation>
    <xs:documentation>
      The schema for the PowerShellWixExtension WiX Extension
    </xs:documentation>
  </xs:annotation>

  <xs:import namespace="http://wixtoolset.org/schemas/v4/wxs" />
  
  <xs:element name="Script">
    <xs:annotation>
      <xs:appinfo>
        <xse:parent namespace="http://wixtoolset.org/schemas/v4/wxs" ref="Package" />
        <xse:parent namespace="http://wixtoolset.org/schemas/v4/wxs" ref="Fragment" />
      </xs:appinfo>
      <xs:documentation>
        Execute PowerShell script via Base64-encoded attribute or inline text
      </xs:documentation>
    </xs:annotation>

    <xs:complexType>
      <xs:attribute name="Id"
                        use="required"
                        type="xs:string">
        <xs:annotation>
          <xs:documentation>The ID for the element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>

      <xs:attribute name="Script" use="optional" type="xs:string">
        <xs:annotation>
          <xs:documentation>Base64-encoded script content (UTF-16 encoded). Use this attribute instead of inner text for WiX 6 compatibility.</xs:documentation>
        </xs:annotation>
      </xs:attribute>

      <xs:attribute name="Elevated" use="optional" default="no" type="wix:YesNoType">
        <xs:annotation>
          <xs:documentation>Set to true if script should run as an elevated user</xs:documentation>
        </xs:annotation>
      </xs:attribute>

      <xs:attribute name="IgnoreErrors" use="optional" default="no" type="wix:YesNoType">
        <xs:annotation>
          <xs:documentation>Set to true to ignore PowerShell errors</xs:documentation>
        </xs:annotation>
      </xs:attribute>

      <xs:attribute name="Order" use="optional" type="xs:int">
        <xs:annotation>
          <xs:documentation>Order of script execution. Note that ordering is within the context and type. For example, elevated scripts will run on different context than non-elevated. Defaults to run in line-number order. Files with explicit ordering will be executed before files with implicit ordering</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      
      <xs:attribute name="Condition" type="xs:string" use="optional">
        <xs:annotation>
          <xs:documentation>Condition on executing the script. For example, 'NOT Installed' or 'REMOVE="ALL"'</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
    
  </xs:element>

  <xs:element name="File">
    <xs:annotation>
      <xs:appinfo>
        <xse:parent namespace="http://wixtoolset.org/schemas/v4/wxs" ref="Package" />
        <xse:parent namespace="http://wixtoolset.org/schemas/v4/wxs" ref="Fragment" />
      </xs:appinfo>
      <xs:documentation>
        Run a PowerShell script file
      </xs:documentation>
    </xs:annotation>

    <xs:complexType>
      <xs:attribute name="Id"
              use="required"
              type="xs:string">
        <xs:annotation>
          <xs:documentation>The ID for the element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>

      <xs:attribute name="File" use="required" type="xs:string">
        <xs:annotation>
          <xs:documentation>The reference to a PowerShell file</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      
      <xs:attribute name="Arguments" use="optional" type="xs:string">
        <xs:annotation>
          <xs:documentation>The arguments for PowerShell file</xs:documentation>
        </xs:annotation>
      </xs:attribute>

      <xs:attribute name="Elevated" use="optional" default="no" type="wix:YesNoType">
        <xs:annotation>
          <xs:documentation>Set to true if script should run as an elevated user</xs:documentation>
        </xs:annotation>
      </xs:attribute>

      <xs:attribute name="IgnoreErrors" use="optional" default="no" type="wix:YesNoType">
        <xs:annotation>
          <xs:documentation>Set to true to ignore PowerShell errors</xs:documentation>
        </xs:annotation>
      </xs:attribute>

      <xs:attribute name="Order" use="optional" type="xs:int">
        <xs:annotation>
          <xs:documentation>Order of script execution. Note that ordering is within the context and type. For example, elevated scripts will run on different context than non-elevated. Defaults to run in line-number order. Files with explicit ordering will be executed before files with implicit ordering</xs:documentation>
        </xs:annotation>
      </xs:attribute>

      <xs:attribute name="Condition" type="xs:string" use="optional">
        <xs:annotation>
          <xs:documentation>Condition on executing the script. For example, 'NOT Installed' or 'REMOVE="ALL"'</xs:documentation>
        </xs:annotation>
      </xs:attribute>

    </xs:complexType>
  </xs:element>
</xs:schema>
